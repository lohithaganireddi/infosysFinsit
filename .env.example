# ==============================================================================
# FinSight Environment Configuration (.env.example)
# Duplicate this file as .env and populate with your production or local values.
# NEVER commit the real .env file or credentials to Git.
# ==============================================================================

# Core Flask Security Configuration
SECRET_KEY=your_persistent_flask_secret_key_here
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SESSION_COOKIE_SECURE=false

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash

# Database Configuration (Planned Neon PostgreSQL Migration)
# Leave unset or empty to use local SQLite (instance/finsight.db)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/finsight?sslmode=require
